<%#
  This template partial is based on app/views/file_system/item/mounts/_mount.html.erb so any changes should be made there too
  and vise versa
%>
<section class="file-system">
  <div class="bread-crumbs">
    <% directory.file_system_route.each do |breadcrumb| %>
      <% if breadcrumb.is_a? FileSystem::Item::Mount %>
        <%= link_to breadcrumb.name, file_system_item_mount_path(breadcrumb) %>
      <% elsif breadcrumb == directory %>
        <span><%= breadcrumb.name %></span>
      <% else %>
        <%= link_to breadcrumb.name, file_system_item_directory_path(breadcrumb, target: params.require(:target)) %>
      <% end %>
      <span>/</span>
    <% end %>
  </div>
  <div class="file-system-items" data-controller="dialog">
    <% directory.directories.in_system.order(params.fetch(:order_by, "name") => params.fetch(:order_direction, "desc")).find_each do |directory| %>
      <%= link_to file_system_item_directory_path(directory, target: params.require(:target)), class: "file-system-item" do %>
        <i class="fa-solid fa-folder"></i> <span><%= directory.name %></span>
      <% end %>
    <% end %>
    <% directory.files.in_system.order(params.fetch(:order_by, "name") => params.fetch(:order_direction, "desc")).find_each do |file| %>
      <%= link_to download_file_system_item_file_path(file), id: dom_id(file), class: "file-system-item", target: "_blank", data: { action: "click->dialog#open", dialog: dom_id(file) } do %>
        <i class="fa-regular fa-file"></i> <span><%= file.name %></span>
      <% end %>
      <dialog name="<%= dom_id(file) %>" data-dialog-target="dialog" id="<%= dom_id(file) %>">
        <%= render partial: "file_system/item/files/preview_skeleton", locals: { file: } %>
      </dialog>
    <% end %>
  </div>
</section>