<section class="file-system">
  <div class="bread-crumbs">
    <i class="fa-solid fa-folder-tree"></i> <span>/</span>
  </div>
  <div class="file-system-items">
    <% file_system.directories.each do |directory| %>
      <%= link_to file_system_directory_path(file_system, directory), class: "file-system-item" do %>
        <i class="fa-solid fa-folder"></i> <span><%= directory.name %></span>
      <% end %>
    <% end %>
    <% file_system.files.each do |file| %>
      <%= link_to download_file_system_file_path(file_system, file), class: "file-system-item", target: "_blank" do %>
        <i class="fa-solid fa-file"></i> <span><%= file.name %></span>
      <% end %>
    <% end %>
  </div>
</section>