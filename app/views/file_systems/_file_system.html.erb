<section>
  <div>
    <%= file_system.mountable.name %>
  </div>
  <div style="display: flex; gap: 2rem; flex-wrap: wrap;">
    <% file_system.directories.each do |directory| %>
      <%= link_to file_system_directory_path(file_system, directory), style: "display: flex; flex-direction: column; align-items: center; justify-items: center;" do %>
        <%= image_tag "icons/directory.svg", width: 100, height: 100, class: "directory-icon" %>
        <p><%= directory.name %></p>
      <% end %>
    <% end %>
    <% file_system.files.each do |file| %>
      <%= link_to download_file_system_file_path(file_system, file), target: "_blank", style: "display: flex; flex-direction: column; align-items: center; justify-items: center;" do %>
        <%= image_tag attachment_file_system_file_path(file_system, file), width: 100, height: 100 %>
        <p><%= file.name %></p>
      <% end %>
    <% end %>
  </div>
</section>