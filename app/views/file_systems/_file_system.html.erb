<section>
  <div>
    <%= file_system.mountable.name %>
  </div>
  <div>
    <% file_system.directories.each do |directory| %>
      <p>
        Directory: <%=
          link_to directory.name,
                  file_system_directory_path(file_system, directory, format: :turbo_stream),
                  data: { turbo_prefetch: false }
        %>
      </p>
    <% end %>
    <% file_system.files.each do |file| %>
      <p>
        File: <%=
          link_to file.name,
                  download_file_system_file_path(file_system, file),
                  target: "_blank"
        %>
      </p>
    <% end %>
  </div>
</section>