<%#
  This template partial is based on app/views/file_systems/_file_system.html.erb so any changes should be made there too
  and vise versa
%>
<section class="file-system">
  <div class="bread-crumbs">
    <% directory.file_system_route.each do |breadcrumb| %>
      <% if breadcrumb.is_a? FileSystem %>
        <%= link_to file_system_path(breadcrumb) do %>
          <i class="fa-solid fa-folder-tree"></i>
        <% end %>
      <% elsif breadcrumb == directory %>
        <span><%= breadcrumb.name %></span>
      <% else %>
        <%= link_to breadcrumb.name, file_system_directory_path(file_system, breadcrumb) %>
      <% end %>
      <span>/</span>
    <% end %>
  </div>
  <div class="file-system-items" data-controller="dialog">
    <% directory.directories.each do |directory| %>
      <%= link_to file_system_directory_path(file_system, directory), class: "file-system-item" do %>
        <i class="fa-solid fa-folder"></i> <span><%= directory.name %></span>
      <% end %>
    <% end %>
    <% directory.files.each do |file| %>
      <%= link_to download_file_system_file_path(file_system, file), class: "file-system-item", target: "_blank", data: { action: "click->dialog#open", dialog: dom_id(file) } do %>
        <i class="fa-regular fa-file"></i> <span><%= file.name %></span>
      <% end %>
      <dialog class="file-previewer" name="<%= dom_id(file) %>" data-dialog-target="dialog">
        <%= render partial: "file_systems/files/preview_skeleton", locals: { file_system: file_system, file: file } %>
      </dialog>
    <% end %>
  </div>
</section>